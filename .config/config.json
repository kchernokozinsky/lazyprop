{
  "jar_path": "secure-properties-tool.jar",
  "envs_path": "envs.yaml",
  "keybindings": {
    "Main": {
      "<q>": "Quit",
      "<Ctrl-c>": "Quit",
      "<Ctrl-d>": "Quit",
      "<Ctrl-z>": "Suspend",
      "<w>": "Up",
      "<Up>": "Up",
      "<s>": "Down",
      "<Down>": "Down",
      "<Tab>": "Tab",
      "<e>": "Encrypt",
      "<d>": "Decrypt",
      "<Ctrl-y>": "CopyResult",
      "<r>": "ToggleReveal",
      "<p>": "SendToPlayground",
      "</>": "Search",
      "<a>": "AddEnv",
      "<Enter>": "EditEnv",
      "<x>": "DeleteEnv",
      "<Esc>": "Escape",
      "<1>": "GoMain",
      "<2>": "GoPlayground",
      "<3>": "GoAbout",
      "<4>": "GoYaml",
      "<h>": "PrevScreen",
      "<l>": "NextScreen",
      "<?>": "GoAbout"
    },
    "About": {
      "<q>": "Quit",
      "<Ctrl-c>": "Quit",
      "<Ctrl-d>": "Quit",
      "<Ctrl-z>": "Suspend",
      "<w>": "Up",
      "<Up>": "Up",
      "<s>": "Down",
      "<Down>": "Down",
      "<1>": "GoMain",
      "<2>": "GoPlayground",
      "<3>": "GoAbout",
      "<4>": "GoYaml",
      "<h>": "PrevScreen",
      "<l>": "NextScreen",
      "<Esc>": "GoMain",
      "<?>": "GoMain"
    }
  }
}
